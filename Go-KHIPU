        function bindAllEvents() {
            // Mode buttons
            document.querySelectorAll('.chat-mode-btn').forEach(btn => {
                btn.addEventListener('click', () => setChatMode(btn.dataset.mode));
            });

            // Chat submit
            document.getElementById('chat-form').addEventListener('submit', (e) => {
                e.preventDefault();
                const input = document.getElementById('chat-input');
                const val = input.value;
                input.value = '';
                handleSendQuery(val);
            });

            // Quick chips
            document.querySelectorAll('.quick-chip').forEach(chip => {
                chip.addEventListener('click', () => {
                    const raw = chip.textContent.replace(/^[^\w¿]+/, '').trim();
                    handleSendQuery(raw);
                });
            });

            // Clear chat
            document.getElementById('btn-clear-chat').addEventListener('click', () => {
                chatHistoryMemory = [];
                document.getElementById('chat-messages').innerHTML = '';
                appendAiMessage(`<p class="text-slate-300">Memoria de conversación reiniciada. Lista para nuevas consultas.</p>`);
            });

            // Voice input (Web Speech API)
            document.getElementById('btn-voice').addEventListener('click', () => {
                const SpeechRec = window.SpeechRecognition || window.webkitSpeechRecognition;
                if (!SpeechRec) {
                    showToast('Tu navegador no soporta dictado por voz.', 'error');
                    return;
                }
                const rec = new SpeechRec();
                rec.lang = 'es-PE';
                const btn = document.getElementById('btn-voice');
                btn.classList.add('text-rose-400', 'border-rose-500');
                showToast('Escuchando... habla ahora', 'info');
                rec.onresult = (ev) => {
                    const transcript = ev.results[0][0].transcript;
                    document.getElementById('chat-input').value = transcript;
                    handleSendQuery(transcript);
                };
                rec.onend = () => btn.classList.remove('text-rose-400', 'border-rose-500');
                rec.start();
            });

            // PDF Upload & Drag-and-drop
            const pdfInput = document.getElementById('pdf-file-input');
            const dropzone = document.getElementById('pdf-dropzone');

            pdfInput.addEventListener('change', (e) => {
                if (e.target.files[0]) processPdfFile(e.target.files[0]);
            });
            dropzone.addEventListener('dragover', (e) => {
                e.preventDefault();
                dropzone.classList.add('border-cyber-gold');
            });
            dropzone.addEventListener('dragleave', () => dropzone.classList.remove('border-cyber-gold'));
            dropzone.addEventListener('drop', (e) => {
                e.preventDefault();
                dropzone.classList.remove('border-cyber-gold');
                if (e.dataTransfer.files[0]) processPdfFile(e.dataTransfer.files[0]);
            });

            document.getElementById('btn-remove-pdf').addEventListener('click', (e) => {
                e.stopPropagation();
                activePdfContext = null;
                pdfInput.value = '';
                document.getElementById('pdf-status-title').textContent = 'Arrastra o sube un PDF aquí';
                document.getElementById('pdf-status-subtitle').textContent = 'Lectura paralela instantánea en memoria';
                document.getElementById('btn-remove-pdf').classList.add('hidden');
                setChatMode('general');
                showToast('PDF desvinculado de la sesión', 'info');
            });

            // Case selector & Physics toggle
            document.getElementById('caseSelector').addEventListener('change', (e) => {
                currentCaseIndex = parseInt(e.target.value, 10);
                selectedKnot = { cordIdx: 0, knotIdx: 0 };
                refreshCaseDashboard();
            });

            document.getElementById('btn-toggle-breeze').addEventListener('click', () => {
                breezeActive = !breezeActive;
                document.getElementById('txt-breeze-status').textContent = breezeActive ? 'Física ON' : 'Física OFF';
                document.getElementById('breeze-dot').className = breezeActive
                    ? 'w-2 h-2 rounded-full bg-cyber-gold'
                    : 'w-2 h-2 rounded-full bg-slate-600';
                if (!breezeActive) renderKhipuFrame();
            });

            // Language toggle
            const btnEs = document.getElementById('btn-lang-es');
            const btnQu = document.getElementById('btn-lang-qu');
            btnEs.addEventListener('click', () => {
                currentLang = 'es';
                btnEs.className = 'px-2.5 py-1 rounded-lg bg-cyber-gold text-black font-bold transition';
                btnQu.className = 'px-2.5 py-1 rounded-lg text-slate-400 hover:text-white transition';
                refreshCaseDashboard();
            });
            btnQu.addEventListener('click', () => {
                currentLang = 'qu';
                btnQu.className = 'px-2.5 py-1 rounded-lg bg-cyber-gold text-black font-bold transition';
                btnEs.className = 'px-2.5 py-1 rounded-lg text-slate-400 hover:text-white transition';
                refreshCaseDashboard();
                showToast('Runasimi unanchay kicharisqa (Modo Quechua activo)', 'success');
            });

            // Audit selected knot with AI
            document.getElementById('btn-audit-knot-ai').addEventListener('click', () => {
                const activeCase = CASES_DATA[currentCaseIndex];
                const knot = activeCase.cords[selectedKnot.cordIdx]?.knots[selectedKnot.knotIdx];
                if (!knot) return;
                handleSendQuery(`Analiza estratégicamente el hito "${knot.title}" (${knot.articles.join(', ')}): "${knot.summary}". Dame riesgos procesales y pasos inmediatos.`);
            });

            // Draft Modal actions
            document.getElementById('btn-close-draft-modal').addEventListener('click', () => {
                document.getElementById('draft-modal').classList.add('hidden');
            });

            document.getElementById('btn-copy-draft').addEventListener('click', () => {
                const area = document.getElementById('draft-content');
                area.select();
                document.execCommand('copy');
                showToast('Escrito copiado al portapapeles', 'success');
            });

            document.getElementById('btn-ai-expand-draft').addEventListener('click', async () => {
                if (!currentDraftKnot) return;
                const btn = document.getElementById('btn-ai-expand-draft');
                const area = document.getElementById('draft-content');
                const prevLabel = btn.innerHTML;
                btn.innerHTML = '<span>⚡ Redactando con Gemini Flash...</span>';
                btn.disabled = true;

                try {
                    const activeCase = CASES_DATA[currentCaseIndex];
                    const prompt = `Redacta un escrito procesal formal completo conforme a la práctica forense peruana para el expediente ${activeCase.expediente} (${activeCase.title}).
Acto procesal: "${currentDraftKnot.title}".
Base normativa: ${currentDraftKnot.articles.join(', ')}.
Hechos clave: ${currentDraftKnot.summary}.
Estructura requerida: Expediente, Especialista, Escrito, Sumilla, Destinatario, I. Petitorio, II. Fundamentos de Hecho, III. Fundamentos de Derecho, IV. Medios Probatorios / Anexos y Por Tanto.`;

                    const { text } = await callGeminiFlash(prompt, { isolated: true, skipPdf: false });
                    area.value = text;
                    showToast('Escrito jurídico redactado con éxito', 'success');
                } catch (err) {
                    showToast('Error al redactar con IA: ' + err.message, 'error');
                } finally {
                    btn.innerHTML = prevLabel;
                    btn.disabled = false;
                }
            });

            // Add New Knot Modal
            const knotModal = document.getElementById('new-knot-modal');
            document.getElementById('btn-open-new-knot').addEventListener('click', () => {
                const activeCase = CASES_DATA[currentCaseIndex];
                const sel = document.getElementById('nk-cord');
                sel.innerHTML = activeCase.cords.map((c, idx) => `<option value="${idx}" class="bg-slate-900">${c.name}</option>`).join('');
                knotModal.classList.remove('hidden');
            });
            document.getElementById('btn-close-knot-modal').addEventListener('click', () => knotModal.classList.add('hidden'));

            document.getElementById('form-new-knot').addEventListener('submit', (e) => {
                e.preventDefault();
                const cIdx = parseInt(document.getElementById('nk-cord').value, 10);
                const title = document.getElementById('nk-title').value.trim();
                const art = document.getElementById('nk-art').value.trim() || 'TUO LPAG Ley 27444';
                const daysRaw = document.getElementById('nk-days').value;
                const summary = document.getElementById('nk-summary').value.trim();
                const critical = document.getElementById('nk-critical').checked;

                const cord = CASES_DATA[currentCaseIndex].cords[cIdx];
                const newId = `K-${(cIdx + 1) * 100 + cord.knots.length + 1}`;
                cord.knots.push({
                    id: newId,
                    title,
                    title_qu: title,
                    date: 'Hoy',
                    status: critical ? 'PLAZO FATAL' : 'REGISTRADO',
                    daysRemaining: daysRaw !== '' ? parseInt(daysRaw, 10) : null,
                    critical,
                    articles: [art],
                    summary,
                    vulnerability: critical ? 'Atención prioritaria requerida por vencimiento.' : 'Hito anudado satisfactoriamente en la cuerda.',
                    draftSnippet: `SUMILLA: ${title.toUpperCase()}\n\nSEÑOR JUEZ / TRIBUNAL:\nAl amparo de ${art}, exponemos:\n\n${summary}`
                });

                selectedKnot = { cordIdx: cIdx, knotIdx: cord.knots.length - 1 };
                knotModal.classList.add('hidden');
                e.target.reset();
                refreshCaseDashboard();
                showToast(`Nudo ${newId} tejido en el Khipu`, 'success');
            });

            // API Key Modal
            const apiModal = document.getElementById('api-key-modal');
            document.getElementById('btn-api-key').addEventListener('click', () => {
                document.getElementById('custom-api-key-input').value = customApiKey;
                apiModal.classList.remove('hidden');
            });
            document.getElementById('btn-close-api-modal').addEventListener('click', () => apiModal.classList.add('hidden'));
            document.getElementById('btn-save-api-key').addEventListener('click', () => {
                customApiKey = document.getElementById('custom-api-key-input').value.trim();
                try { localStorage.setItem('khipu_custom_key', customApiKey); } catch (_) {}
                document.getElementById('txt-api-status').textContent = customApiKey ? 'Clave Propia' : 'Gemini Activo';
                apiModal.classList.add('hidden');
                showToast('Configuración de Gemini guardada', 'success');
            });
        }

        // ============================================================
        // 9. BOOTSTRAP ON WINDOW LOAD
        // ============================================================
        window.onload = function () {
            initCanvas();
            bindAllEvents();
            refreshCaseDashboard();
            animationLoop();
        };
    </script>
</body>
</html>
