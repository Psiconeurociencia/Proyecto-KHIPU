        function showToast(message, type = 'info') {
            const container = document.getElementById('toast-container');
            const colors = {
                info: 'border-cyber-gold/50 text-amber-200 bg-slate-950/95',
                success: 'border-emerald-500/50 text-emerald-300 bg-slate-950/95',
                error: 'border-rose-500/50 text-rose-300 bg-slate-950/95'
            };
            const el = document.createElement('div');
            el.className = `px-4 py-2.5 rounded-xl border text-xs font-mono shadow-xl backdrop-blur-md msg-anim ${colors[type] || colors.info}`;
