<!DOCTYPE html>
<html lang="es" class="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>KHIPU JURIS AI — Estación Jurídica Ultrarrápida & Auditoría Andina</title>

    <!-- Preconnect for ultra-fast font & CDN loading -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@600;700;800&family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500;700&display=swap" rel="stylesheet">

    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    colors: {
                        cyber: {
                            bg: '#06080D',
                            base: '#0B0F17',
                            card: '#111724',
                            border: 'rgba(245, 183, 64, 0.18)',
                            gold: '#F5B740',
                            cyan: '#06B6D4',
                            emerald: '#10B981',
                            crimson: '#F43F5E',
                            violet: '#8B5CF6'
                        }
                    },
                    fontFamily: {
                        sans: ['Inter', 'system-ui', 'sans-serif'],
                        cinzel: ['Cinzel', 'serif'],
                        mono: ['JetBrains Mono', 'monospace']
                    }
                }
            }
        };
    </script>

    <!-- PDF.js for instant client-side parallel PDF extraction -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.min.js"></script>
    <script>
        if (window.pdfjsLib) {
            pdfjsLib.GlobalWorkerOptions.workerSrc = 'https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.worker.min.js';
        }
    </script>

    <style>
        * {
            box-sizing: border-box;
        }
        body {
            background-color: #06080D;
            color: #E2E8F0;
            background-image:
                radial-gradient(circle at 15% 0%, rgba(245, 183, 64, 0.09) 0%, transparent 45%),
                radial-gradient(circle at 85% 100%, rgba(6, 182, 212, 0.08) 0%, transparent 45%),
                linear-gradient(rgba(255, 255, 255, 0.018) 1px, transparent 1px),
                linear-gradient(90deg, rgba(255, 255, 255, 0.018) 1px, transparent 1px);
            background-size: 100% 100%, 100% 100%, 36px 36px, 36px 36px;
        }
        .glass-panel {
            background: rgba(14, 19, 30, 0.78);
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
        }
        ::-webkit-scrollbar {
            width: 5px;
            height: 5px;
        }
        ::-webkit-scrollbar-track {
            background: transparent;
        }
        ::-webkit-scrollbar-thumb {
            background: rgba(148, 163, 184, 0.25);
            border-radius: 9999px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: #F5B740;
        }
        @keyframes slideUp {
            from { opacity: 0; transform: translateY(8px); }
            to { opacity: 1; transform: translateY(0); }
        }
        .msg-anim {
            animation: slideUp 0.2s cubic-bezier(0.16, 1, 0.3, 1) forwards;
        }
    </style>
</head>
<body class="min-h-screen flex flex-col font-sans selection:bg-cyber-gold selection:text-black overflow-x-hidden">

    <!-- Toast Notification Container (No native alert) -->
    <div id="toast-container" class="fixed bottom-5 right-5 z-50 flex flex-col gap-2 pointer-events-none"></div>

    <!-- ========================================================== -->
    <!-- TOP BAR NAVIGATION                                         -->
    <!-- ========================================================== -->
    <header class="sticky top-0 z-30 border-b border-cyber-border bg-cyber-bg/85 backdrop-blur-xl">
        <div class="max-w-[1600px] mx-auto px-4 py-2.5 flex flex-wrap items-center justify-between gap-3">
            <!-- Brand -->
            <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-amber-500 via-cyber-gold to-yellow-200 p-[1.5px] shadow-lg shadow-amber-500/20">
                    <div class="w-full h-full bg-cyber-bg rounded-[10px] flex items-center justify-center font-cinzel font-extrabold text-cyber-gold text-lg">
                        ᚴ
                    </div>
                </div>
                <div>
                    <div class="flex items-center gap-2">
                        <h1 class="font-cinzel font-bold text-base sm:text-lg tracking-wider text-white">
                            KHIPU <span class="text-cyber-gold">JURIS</span> AI
                        </h1>
                        <span class="px-2 py-0.5 text-[10px] font-mono font-semibold rounded-full bg-emerald-500/10 text-emerald-400 border border-emerald-500/30 flex items-center gap-1">
                            <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-ping"></span>
                            FLASH 3 TURBO
                        </span>
                    </div>
                    <p id="header-subtitle" class="text-[11px] text-slate-400 hidden sm:block">
                        Sistema Andino de Registro Probatorio, Análisis PDF Ultrarrápido & IA Legal
                    </p>
                </div>
            </div>

            <!-- Controls & Switchers -->
            <div class="flex items-center flex-wrap gap-2">
                <!-- Case Selector -->
                <div class="flex items-center gap-2 bg-cyber-card px-3 py-1.5 rounded-xl border border-slate-800 hover:border-cyber-gold/40 transition">
                    <span class="text-[10px] font-mono uppercase text-cyber-gold hidden md:inline">Expediente:</span>
                    <select id="caseSelector" class="bg-transparent text-xs font-medium text-slate-200 focus:outline-none cursor-pointer">
                        <option value="0" class="bg-slate-900">01 • Arbitraje OSCE (Obras Viales)</option>
                        <option value="1" class="bg-slate-900">02 • Penal Anticorrupción (Colusión)</option>
                        <option value="2" class="bg-slate-900">03 • Propiedad Comunal & Ayllu (Civil)</option>
                    </select>
                </div>

                <!-- Add Knot Button -->
                <button id="btn-open-new-knot" class="px-3 py-1.5 rounded-xl text-xs font-medium bg-cyber-gold/15 hover:bg-cyber-gold/25 text-cyber-gold border border-cyber-gold/40 transition flex items-center gap-1.5">
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M12 4v16m8-8H4"/></svg>
                    <span>Anudar Hito</span>
                </button>

                <!-- Intercultural Language Toggle -->
                <div class="flex items-center bg-cyber-card p-0.5 rounded-xl border border-slate-800 text-[11px] font-mono">
                    <button id="btn-lang-es" class="px-2.5 py-1 rounded-lg bg-cyber-gold text-black font-bold transition">ES</button>
                    <button id="btn-lang-qu" class="px-2.5 py-1 rounded-lg text-slate-400 hover:text-white transition">RUNASIMI</button>
                </div>

                <!-- Optional API Key Button -->
                <button id="btn-api-key" class="px-3 py-1.5 rounded-xl text-xs font-mono bg-cyber-card hover:bg-slate-800 text-slate-300 border border-slate-800 hover:border-cyber-gold/50 transition flex items-center gap-1.5" title="Configurar clave API opcional">
                    <svg class="w-3.5 h-3.5 text-cyber-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z"/></svg>
                    <span id="txt-api-status" class="hidden sm:inline">Gemini Activo</span>
                </button>
            </div>
        </div>
    </header>

    <!-- ========================================================== -->
    <!-- MAIN 3-COLUMN WORKSTATION                                  -->
    <!-- ========================================================== -->
    <main class="flex-1 max-w-[1600px] w-full mx-auto p-3 sm:p-4 grid grid-cols-1 lg:grid-cols-12 gap-4">

        <!-- ====================================================== -->
        <!-- LEFT PANEL: ULTRA-FAST GEMINI 3 FLASH + PDF AUDITOR    -->
        <!-- ====================================================== -->
        <section class="lg:col-span-4 flex flex-col glass-panel rounded-2xl border border-cyber-border overflow-hidden h-[640px] lg:h-[calc(100vh-92px)] shadow-2xl">
            <!-- Top Controls -->
            <div class="p-3 border-b border-slate-800/90 bg-cyber-base/70 space-y-2.5">
                <div class="flex items-center justify-between">
                    <div class="flex items-center gap-2">
                        <span class="w-2 h-2 rounded-full bg-cyber-cyan animate-pulse"></span>
                        <span id="txt-ai-title" class="text-xs font-mono uppercase font-bold text-white tracking-wide">Kamayuq Gemini IA</span>
                    </div>
                    <div class="flex items-center gap-1.5">
                        <span id="latency-badge" class="text-[10px] font-mono px-2 py-0.5 rounded bg-slate-900 text-emerald-400 border border-slate-800">Listo</span>
                        <button id="btn-clear-chat" class="p-1 rounded-lg hover:bg-slate-800 text-slate-400 hover:text-white transition" title="Limpiar conversación">
                            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
                        </button>
                    </div>
                </div>

                <!-- 3-Way Mode Switcher -->
                <div class="grid grid-cols-3 gap-1 bg-slate-950/90 p-1 rounded-xl border border-slate-800/80 text-[11px] font-medium">
                    <button id="mode-general" data-mode="general" class="chat-mode-btn py-1.5 px-2 rounded-lg bg-cyber-gold text-black font-semibold transition truncate">
                        ✦ Libre
                    </button>
                    <button id="mode-pdf" data-mode="pdf" class="chat-mode-btn py-1.5 px-2 rounded-lg text-slate-400 hover:text-white transition truncate">
                        📄 Mi PDF
                    </button>
                    <button id="mode-web" data-mode="web" class="chat-mode-btn py-1.5 px-2 rounded-lg text-slate-400 hover:text-white transition truncate">
                        🌐 Web Legal
                    </button>
                </div>

                <!-- Instant Drag & Drop PDF Zone -->
                <div id="pdf-dropzone" class="relative group rounded-xl border border-dashed border-slate-700 hover:border-cyber-gold bg-slate-950/60 px-3 py-2 transition flex items-center justify-between gap-2">
                    <input type="file" id="pdf-file-input" accept="application/pdf" class="absolute inset-0 w-full h-full opacity-0 cursor-pointer z-10">
                    <div class="flex items-center gap-2.5 min-w-0">
                        <div id="pdf-icon-box" class="w-8 h-8 rounded-lg bg-rose-500/15 border border-rose-500/30 text-rose-400 flex items-center justify-center font-mono text-[10px] font-bold shrink-0">
                            PDF
                        </div>
                        <div class="min-w-0">
                            <p id="pdf-status-title" class="text-xs font-medium text-slate-200 truncate">Arrastra o sube un PDF aquí</p>
                            <p id="pdf-status-subtitle" class="text-[10px] font-mono text-slate-400 truncate">Lectura paralela instantánea en memoria</p>
                        </div>
                    </div>
                    <button id="btn-remove-pdf" type="button" class="hidden relative z-20 p-1.5 rounded-lg bg-rose-500/10 hover:bg-rose-500/25 text-rose-400 transition shrink-0" title="Desvincular PDF">
                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
                    </button>
                </div>
                <!-- Progress Bar for PDF -->
                <div id="pdf-progress-wrap" class="hidden w-full h-1 bg-slate-900 rounded-full overflow-hidden">
                    <div id="pdf-progress-bar" class="h-full bg-gradient-to-r from-cyber-emerald to-cyber-cyan w-0 transition-all duration-150"></div>
                </div>
            </div>

            <!-- Chat Stream -->
            <div id="chat-messages" class="flex-1 overflow-y-auto p-3.5 space-y-3 text-xs scroll-smooth">
                <div class="flex gap-2.5 items-start msg-anim">
                    <div class="w-7 h-7 rounded-lg bg-cyber-gold/20 border border-cyber-gold/40 text-cyber-gold flex items-center justify-center font-cinzel font-bold shrink-0">
                        K
                    </div>
                    <div class="bg-slate-900/90 border border-slate-800 rounded-2xl rounded-tl-sm p-3.5 text-slate-200 space-y-2 leading-relaxed max-w-[92%]">
                        <div class="flex items-center justify-between">
                            <span class="text-[10px] font-mono font-bold text-cyber-gold uppercase">Kamayuq Flash 3 • Activo</span>
                        </div>
                        <p>¡Allillanchu! Soy tu estación de inteligencia jurídica y general de alta velocidad:</p>
                        <ul class="space-y-1 text-[11.5px] text-slate-300 list-disc pl-4">
                            <li><strong class="text-white">Modo Libre:</strong> Pregúntame cualquier tema de derecho, código, redacción o consulta general.</li>
                            <li><strong class="text-white">Modo Mi PDF:</strong> Sube contratos, demandas o leyes en PDF; los tejeré en el Khipu y responderé citando páginas exactas.</li>
                            <li><strong class="text-white">Modo Web Legal:</strong> Conecta con Google Search para buscar normas y jurisprudencia reciente.</li>
                        </ul>
                    </div>
                </div>
            </div>

            <!-- Instant Action Chips -->
            <div class="px-3 py-2 border-t border-slate-800/70 bg-cyber-base/50 flex gap-1.5 overflow-x-auto no-scrollbar">
                <button type="button" class="quick-chip shrink-0 text-[10.5px] font-mono px-2.5 py-1 rounded-lg bg-slate-900 hover:bg-slate-800 text-slate-300 border border-slate-800 hover:border-cyber-gold/40 transition">
                    ⚖️ Plazo apelación SINOE
                </button>
                <button type="button" class="quick-chip shrink-0 text-[10.5px] font-mono px-2.5 py-1 rounded-lg bg-slate-900 hover:bg-slate-800 text-slate-300 border border-slate-800 hover:border-cyber-gold/40 transition">
                    📄 Resume y audita mi PDF
                </button>
                <button type="button" class="quick-chip shrink-0 text-[10.5px] font-mono px-2.5 py-1 rounded-lg bg-slate-900 hover:bg-slate-800 text-slate-300 border border-slate-800 hover:border-cyber-gold/40 transition">
                    📝 Redacta cláusula penalidad
                </button>
                <button type="button" class="quick-chip shrink-0 text-[10.5px] font-mono px-2.5 py-1 rounded-lg bg-slate-900 hover:bg-slate-800 text-slate-300 border border-slate-800 hover:border-cyber-gold/40 transition">
                    🔍 Riesgos del expediente actual
                </button>
            </div>

            <!-- Chat Input Form with Voice Dictation -->
            <form id="chat-form" class="p-3 border-t border-slate-800 bg-cyber-card/90 flex items-center gap-2">
                <button type="button" id="btn-voice" class="p-2.5 rounded-xl bg-slate-900 hover:bg-slate-800 text-slate-400 hover:text-cyber-cyan border border-slate-800 transition shrink-0" title="Dictar por voz">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11a7 7 0 01-7 7m0 0a7 7 0 01-7-7m7 7v4m0 0H8m4 0h4m-4-8a3 3 0 01-3-3V5a3 3 0 116 0v6a3 3 0 01-3 3z"/></svg>
                </button>
                <input id="chat-input" type="text" autocomplete="off" placeholder="Escribe cualquier consulta o pregunta sobre tu PDF..."
                       class="flex-1 bg-cyber-bg border border-slate-800 focus:border-cyber-gold rounded-xl px-3.5 py-2.5 text-xs text-white placeholder-slate-500 focus:outline-none transition">
                <button type="submit" id="btn-submit-chat" class="px-4 py-2.5 rounded-xl bg-gradient-to-r from-amber-500 to-cyber-gold text-black font-bold text-xs hover:brightness-110 active:scale-95 transition flex items-center gap-1.5 shrink-0 shadow-lg shadow-amber-500/20">
                    <span>Enviar</span>
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 12h14M12 5l7 7-7 7"/></svg>
                </button>
            </form>
        </section>

        <!-- ====================================================== -->
        <!-- CENTER PANEL: HIGH-FPS INTERACTIVE KHIPU CANVAS        -->
        <!-- ====================================================== -->
        <section class="lg:col-span-5 flex flex-col glass-panel rounded-2xl border border-cyber-border overflow-hidden h-[560px] lg:h-[calc(100vh-92px)] shadow-2xl">
            <!-- Canvas Header -->
            <div class="p-3.5 border-b border-slate-800/90 bg-cyber-base/70 flex flex-wrap items-center justify-between gap-2">
                <div>
                    <div class="flex items-center gap-2">
                        <span class="text-[10px] font-mono uppercase tracking-wider text-cyber-gold">Arquitectura Visual del Caso</span>
                        <span id="badge-expediente" class="text-[10px] font-mono px-2 py-0.5 rounded bg-amber-500/10 text-amber-300 border border-amber-500/25">EXP. 04521-2024</span>
                    </div>
                    <h2 id="case-main-title" class="text-sm font-bold text-white font-cinzel mt-0.5 truncate max-w-md">
                        Arbitraje OSCE: Consorcio Vial vs. MTC
                    </h2>
                </div>

                <div class="flex items-center gap-1.5">
                    <button id="btn-toggle-breeze" class="px-2.5 py-1.5 rounded-lg text-[11px] font-mono bg-slate-900 hover:bg-slate-800 text-slate-300 border border-slate-800 transition flex items-center gap-1.5">
                        <span id="breeze-dot" class="w-2 h-2 rounded-full bg-cyber-gold"></span>
                        <span id="txt-breeze-status">Física ON</span>
                    </button>
                </div>
            </div>

            <!-- KPI Mini Strip -->
            <div class="grid grid-cols-3 divide-x divide-slate-800/80 border-b border-slate-800/80 bg-slate-950/60 text-center py-2 text-[11px]">
                <div>
                    <span class="text-slate-500 font-mono text-[10px] block">CUERDAS</span>
                    <span id="kpi-cords" class="font-bold text-white font-mono">3</span>
                </div>
                <div>
                    <span class="text-slate-500 font-mono text-[10px] block">NUDOS / HITOS</span>
                    <span id="kpi-knots" class="font-bold text-cyber-gold font-mono">5</span>
                </div>
                <div>
                    <span class="text-slate-500 font-mono text-[10px] block">ALERTAS CRÍTICAS</span>
                    <span id="kpi-critical" class="font-bold text-rose-400 font-mono">1</span>
                </div>
            </div>

            <!-- Interactive Canvas Viewport -->
            <div id="canvas-wrapper" class="relative flex-1 bg-cyber-bg/80 overflow-hidden select-none">
                <canvas id="khipuCanvas" class="w-full h-full block"></canvas>

                <!-- Floating Hover Tooltip on Canvas -->
                <div id="canvas-tooltip" class="hidden absolute pointer-events-none z-20 bg-slate-950/95 border border-cyber-gold/50 rounded-xl px-3 py-2 shadow-2xl backdrop-blur-md text-[11px] max-w-[230px]">
                    <div class="flex items-center justify-between gap-2 mb-0.5">
                        <span id="tt-id" class="font-mono text-[10px] font-bold text-cyber-gold">K-101</span>
                        <span id="tt-status" class="font-mono text-[9px] px-1.5 py-0.2 rounded bg-slate-800 text-slate-300">ADMITIDO</span>
                    </div>
                    <p id="tt-title" class="font-semibold text-white leading-snug"></p>
                    <p id="tt-date" class="text-[10px] font-mono text-slate-400 mt-0.5"></p>
                </div>

                <!-- Legend Footer Overlay -->
                <div class="absolute bottom-3 inset-x-3 flex flex-wrap items-center justify-between gap-2 pointer-events-none">
                    <div class="bg-slate-950/85 backdrop-blur border border-slate-800 rounded-xl px-3 py-1.5 text-[10px] font-mono text-slate-300 flex items-center gap-3">
                        <span class="flex items-center gap-1"><span class="w-2 h-2 rounded-full bg-cyber-gold"></span>Principal</span>
                        <span class="flex items-center gap-1"><span class="w-2 h-2 rounded-full bg-cyber-crimson"></span>Plazo Fatal</span>
                        <span class="flex items-center gap-1"><span class="w-2 h-2 rounded-full bg-cyber-emerald"></span>PDF Anudado</span>
                    </div>
                    <div class="bg-slate-950/85 backdrop-blur border border-slate-800 rounded-xl px-2.5 py-1.5 text-[10px] font-mono text-slate-400">
                        Clic en cualquier nudo para auditar
                    </div>
                </div>
            </div>
        </section>

        <!-- ====================================================== -->
        <!-- RIGHT PANEL: KHIPUKAMAYUQ INSPECTOR & AI WRIT DRAFTER  -->
        <!-- ====================================================== -->
        <section class="lg:col-span-3 flex flex-col glass-panel rounded-2xl border border-cyber-border overflow-hidden h-[620px] lg:h-[calc(100vh-92px)] shadow-2xl">
            <div class="p-3.5 border-b border-slate-800/90 bg-cyber-base/70 flex items-center justify-between">
                <div>
                    <span class="text-[10px] uppercase font-mono text-cyber-gold">Auditoría Procesal</span>
                    <h3 class="text-sm font-bold text-white font-cinzel">Inspector de Nudos</h3>
                </div>
                <button id="btn-audit-knot-ai" class="px-2.5 py-1 rounded-lg bg-cyber-cyan/15 hover:bg-cyber-cyan/25 text-cyber-cyan border border-cyber-cyan/30 text-[10.5px] font-mono transition" title="Analizar este nudo con Gemini">
                    ⚡ Analizar con IA
                </button>
            </div>

            <div class="flex-1 overflow-y-auto p-3.5 space-y-4">
                <!-- Active Knot Inspector -->
                <div id="knot-inspector" class="p-3.5 rounded-2xl bg-cyber-card/90 border border-slate-800 space-y-3"></div>

                <!-- Cord List Navigator -->
                <div class="space-y-2">
                    <div class="flex items-center justify-between">
                        <span class="text-[10px] uppercase font-mono text-slate-400 font-semibold">Cuerdas del Expediente</span>
                    </div>
                    <div id="cord-summary-list" class="space-y-1.5"></div>
                </div>
            </div>
        </section>
    </main>

    <!-- ========================================================== -->
    <!-- MODAL 1: AI LEGAL DRAFT GENERATOR                          -->
    <!-- ========================================================== -->
    <div id="draft-modal" class="fixed inset-0 bg-black/80 backdrop-blur-md z-50 flex items-center justify-center p-4 hidden">
        <div class="glass-panel w-full max-w-2xl rounded-2xl border border-cyber-gold/60 p-5 sm:p-6 relative shadow-2xl">
            <button id="btn-close-draft-modal" class="absolute top-4 right-4 p-1.5 rounded-lg bg-slate-900 text-slate-400 hover:text-white transition">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
            </button>

            <div class="border-b border-slate-800 pb-3 mb-4 pr-8">
                <span class="text-[10px] font-mono uppercase text-cyber-gold">Automatización Procesal Peruana</span>
                <h3 id="draft-modal-title" class="text-base font-bold text-white font-cinzel mt-0.5">Borrador de Escrito</h3>
