        // ============================================================
        // 3. HIGH-PERFORMANCE CANVAS ENGINE
        // ============================================================
        let canvas, ctx, canvasWidth = 0, canvasHeight = 0;

        function initCanvas() {
            canvas = document.getElementById('khipuCanvas');
            if (!canvas) return;
            ctx = canvas.getContext('2d');
            resizeCanvas();

            canvas.addEventListener('mousemove', handleCanvasHover);
            canvas.addEventListener('mouseleave', () => {
                hoveredKnot = null;
                document.getElementById('canvas-tooltip').classList.add('hidden');
                if (!breezeActive) requestAnimationFrame(renderKhipuFrame);
            });
            canvas.addEventListener('click', handleCanvasClick);
            canvas.addEventListener('touchstart', (e) => {
                if (!e.touches.length) return;
                const rect = canvas.getBoundingClientRect();
                const hit = findKnotAt(e.touches[0].clientX - rect.left, e.touches[0].clientY - rect.top);
                if (hit) selectKnot(hit.cordIdx, hit.knotIdx);
            }, { passive: true });
        }

        function resizeCanvas() {
            if (!canvas || !ctx) return;
            const rect = canvas.getBoundingClientRect();
            const dpr = Math.min(window.devicePixelRatio || 1, 2);
            canvasWidth = rect.width;
            canvasHeight = rect.height;
            canvas.width = canvasWidth * dpr;
            canvas.height = canvasHeight * dpr;
            ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
            renderKhipuFrame();
        }
        window.addEventListener('resize', resizeCanvas);

        function findKnotAt(mx, my) {
            const activeCase = CASES_DATA[currentCaseIndex];
            if (!activeCase) return null;
            for (let c = 0; c < activeCase.cords.length; c++) {
                const knots = activeCase.cords[c].knots;
                for (let k = 0; k < knots.length; k++) {
                    const kn = knots[k];
                    if (kn._x !== undefined && Math.hypot(mx - kn._x, my - kn._y) < 20) {
                        return { cordIdx: c, knotIdx: k, knot: kn, cord: activeCase.cords[c] };
                    }
                }
            }
            return null;
        }

        function handleCanvasHover(e) {
            const rect = canvas.getBoundingClientRect();
            const mx = e.clientX - rect.left;
            const my = e.clientY - rect.top;
            const hit = findKnotAt(mx, my);
            const tt = document.getElementById('canvas-tooltip');

            if (hit) {
                canvas.style.cursor = 'pointer';
                hoveredKnot = { cordIdx: hit.cordIdx, knotIdx: hit.knotIdx };
                document.getElementById('tt-id').textContent = hit.knot.id;
                document.getElementById('tt-status').textContent = hit.knot.status;
                document.getElementById('tt-title').textContent = currentLang === 'qu' && hit.knot.title_qu ? hit.knot.title_qu : hit.knot.title;
                document.getElementById('tt-date').textContent = hit.knot.date;
                tt.classList.remove('hidden');
                tt.style.left = `${Math.min(mx + 16, canvasWidth - 235)}px`;
                tt.style.top = `${Math.max(12, my - 20)}px`;
            } else {
                canvas.style.cursor = 'default';
                hoveredKnot = null;
                tt.classList.add('hidden');
            }
            if (!breezeActive) requestAnimationFrame(renderKhipuFrame);
        }

        function handleCanvasClick(e) {
            const rect = canvas.getBoundingClientRect();
            const hit = findKnotAt(e.clientX - rect.left, e.clientY - rect.top);
            if (hit) selectKnot(hit.cordIdx, hit.knotIdx);
        }

        function renderKhipuFrame() {
            if (!ctx || canvasWidth === 0) return;
            ctx.clearRect(0, 0, canvasWidth, canvasHeight);

            const activeCase = CASES_DATA[currentCaseIndex];
            if (!activeCase) return;

            const mainY = 48;
            const padX = 38;

            // Subtle decimal horizon lines
            ctx.strokeStyle = "rgba(255,255,255,0.03)";
            ctx.lineWidth = 1;
            for (let lvl = 1; lvl <= 4; lvl++) {
                const ly = mainY + lvl * ((canvasHeight - 130) / 4.2);
                ctx.beginPath();
                ctx.moveTo(padX, ly);
                ctx.lineTo(canvasWidth - padX, ly);
                ctx.stroke();
            }

            // Master Primary Cord (Uma Khipu)
            const grad = ctx.createLinearGradient(0, mainY - 6, 0, mainY + 6);
            grad.addColorStop(0, "#78531E");
            grad.addColorStop(0.5, "#F5B740");
            grad.addColorStop(1, "#452D0C");

            ctx.beginPath();
            ctx.moveTo(padX, mainY);
            ctx.lineTo(canvasWidth - padX, mainY);
            ctx.lineWidth = 10;
            ctx.lineCap = "round";
            ctx.strokeStyle = grad;
            ctx.stroke();

            // Braided Diagonal Texture
            ctx.strokeStyle = "rgba(255,255,255,0.22)";
            ctx.lineWidth = 1.6;
            for (let x = padX + 6; x < canvasWidth - padX - 6; x += 12) {
                ctx.beginPath();
                ctx.moveTo(x - 3, mainY - 4);
                ctx.lineTo(x + 3, mainY + 4);
                ctx.stroke();
            }

            // Pendant Cords
            const cords = activeCase.cords;
            const count = cords.length;
            const maxSpan = canvasWidth - 130;
            const spacing = count > 1 ? Math.min(135, maxSpan / (count - 1)) : 0;
            const startX = count > 1 ? (canvasWidth - spacing * (count - 1)) / 2 : canvasWidth / 2;
            const cordLen = Math.min(340, canvasHeight - 115);

            cords.forEach((cord, cIdx) => {
                const bx = startX + cIdx * spacing;
                const sway = breezeActive ? Math.sin(timeTick + cIdx * 0.7) * 6.5 : 0;
                const ex = bx + sway;
                const ey = mainY + cordLen;
                const cpx = bx + sway * 0.35;
                const cpy = mainY + cordLen * 0.52;

                // Top Loop Knot
                ctx.beginPath();
                ctx.arc(bx, mainY + 1, 6, 0, Math.PI * 2);
                ctx.fillStyle = cord.color;
                ctx.fill();
                ctx.lineWidth = 1.5;
                ctx.strokeStyle = "#06080D";
                ctx.stroke();

                // Cord body
                ctx.beginPath();
                ctx.moveTo(bx, mainY + 4);
                ctx.quadraticCurveTo(cpx, cpy, ex, ey);
                ctx.lineWidth = 3.2;
                ctx.strokeStyle = cord.color;
                ctx.stroke();

                // Tassel fringe
                ctx.beginPath();
                ctx.moveTo(ex, ey);
                ctx.lineTo(ex - 4, ey + 13);
                ctx.moveTo(ex, ey);
                ctx.lineTo(ex + 4, ey + 13);
                ctx.lineWidth = 1.8;
                ctx.strokeStyle = cord.color;
                ctx.stroke();

                // Cord Label
                ctx.font = "600 10px 'JetBrains Mono'";
                ctx.fillStyle = cord.color;
                ctx.textAlign = "center";
                const lbl = (currentLang === 'qu' && cord.name_qu ? cord.name_qu : cord.name);
                ctx.fillText(lbl.length > 17 ? lbl.slice(0, 16) + "…" : lbl, ex, ey + 27);

                // Knots along cord
                const kTotal = cord.knots.length;
                cord.knots.forEach((knot, kIdx) => {
                    const t = kTotal === 1 ? 0.42 : 0.22 + (kIdx * (0.64 / Math.max(1, kTotal - 1)));
                    const ky = mainY + cordLen * t;
                    const kx = (1 - t) * (1 - t) * bx + 2 * (1 - t) * t * cpx + t * t * ex;
                    knot._x = kx;
                    knot._y = ky;

                    const isSel = selectedKnot && selectedKnot.cordIdx === cIdx && selectedKnot.knotIdx === kIdx;
                    const isHov = hoveredKnot && hoveredKnot.cordIdx === cIdx && hoveredKnot.knotIdx === kIdx;

                    ctx.save();
                    if (isSel || isHov) {
                        ctx.shadowColor = knot.critical ? "#F43F5E" : cord.color;
                        ctx.shadowBlur = 16;
                    }

                    // Critical pulse ring
                    if (knot.critical) {
                        const pulseR = 13 + Math.sin(timeTick * 2.5) * 2.5;
                        ctx.beginPath();
                        ctx.arc(kx, ky, pulseR, 0, Math.PI * 2);
                        ctx.strokeStyle = "rgba(244, 63, 94, 0.45)";
                        ctx.lineWidth = 1.8;
                        ctx.stroke();
                    }

                    // Knot body (stylized Andean woven torus)
                    const radius = isSel ? 10.5 : (isHov ? 9.5 : 7.8);
                    ctx.beginPath();
                    ctx.arc(kx, ky, radius, 0, Math.PI * 2);
                    ctx.fillStyle = knot.critical ? "#F43F5E" : cord.color;
                    ctx.fill();
                    ctx.lineWidth = isSel ? 2.5 : 1.5;
                    ctx.strokeStyle = isSel ? "#FFFFFF" : "#06080D";
                    ctx.stroke();

                    // Inner weave dot
                    ctx.beginPath();
                    ctx.arc(kx, ky, isSel ? 3.8 : 2.5, 0, Math.PI * 2);
                    ctx.fillStyle = "#FFFFFF";
                    ctx.fill();
                    ctx.restore();
                });
            });
        }

        function animationLoop() {
            if (breezeActive) {
                timeTick += 0.038;
                renderKhipuFrame();
            }
            requestAnimationFrame(animationLoop);
        }

