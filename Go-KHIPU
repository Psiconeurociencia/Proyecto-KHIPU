        // ============================================================
        // 6. ULTRA-FAST GEMINI 3 FLASH API + SEARCH GROUNDING
        // ============================================================
        function escapeHtml(str) {
            return String(str)
                .replace(/&/g, '&amp;')
                .replace(/</g, '&lt;')
                .replace(/>/g, '&gt;');
        }

        function formatMarkdownToHtml(md) {
            let safe = escapeHtml(md);
            // Code blocks
            safe = safe.replace(/```([\s\S]*?)```/g, '<pre class="bg-slate-950 border border-slate-800 rounded-xl p-2.5 my-2 overflow-x-auto font-mono text-[11px] text-amber-200">$1</pre>');
            // Inline code
            safe = safe.replace(/`([^`]+)`/g, '<code class="px-1.5 py-0.5 rounded bg-slate-950 text-cyber-gold font-mono text-[11px]">$1</code>');
            // Headings
            safe = safe.replace(/^### (.*)$/gm, '<h4 class="font-bold text-cyber-gold mt-2 mb-1 text-xs uppercase font-mono">$1</h4>');
            safe = safe.replace(/^## (.*)$/gm, '<h3 class="font-bold text-white mt-2.5 mb-1 text-xs">$1</h3>');
            // Bold & Italic
            safe = safe.replace(/\*\*(.*?)\*\*/g, '<strong class="text-white font-semibold">$1</strong>');
            safe = safe.replace(/\*(.*?)\*/g, '<em>$1</em>');
            // Bullet lists
            safe = safe.replace(/^\s*[-*]\s+(.*)$/gm, '<div class="flex gap-1.5 items-start my-0.5"><span class="text-cyber-gold">•</span><span>$1</span></div>');
            // Linebreaks
            safe = safe.replace(/\n\n/g, '<div class="h-2"></div>').replace(/\n/g, '<br>');
            return safe;
        }

        async function callGeminiFlash(userQuery, options = {}) {
            const effectiveKey = customApiKey || apiKey;
            const apiUrl = `https://generativelanguage.googleapis.com/v1beta/models/${GEMINI_MODEL}:generateContent?key=${effectiveKey}`;

            const activeCase = CASES_DATA[currentCaseIndex];
            const caseBrief = `Expediente activo en pantalla: "${activeCase.title}" (${activeCase.expediente}).`;

            let systemPrompt = `Eres KHIPU JURIS AI, un asistente experto de altísima velocidad especializado en Derecho (peruano, comparado, contrataciones del Estado, procesal civil, penal y administrativo) y también capaz de responder cualquier pregunta general de programación, ciencia, historia o redacción con precisión, concisión y claridad.
${caseBrief}
Reglas:
- Ve directo al grano con estructura clara, viñetas y artículos normativos exactos cuando sea una consulta jurídica.
- Si el usuario adjuntó un PDF, prioriza el contenido del PDF y cita el número de [PÁGINA X] donde se encuentra el dato. Si no está en el PDF, indícalo en una línea y responde usando tu conocimiento general.`;

            if (currentLang === 'qu') {
                systemPrompt += `\n- El modo intercultural Runasimi (Quechua sureño/Cusco) está activo: incluye un breve saludo o términos clave en quechua junto con la explicación clara.`;
            }

            let finalPrompt = userQuery;
            if (activePdfContext && (activeChatMode === 'pdf' || !options.skipPdf)) {
                const maxChars = 65000;
                const docSlice = activePdfContext.text.slice(0, maxChars);
                finalPrompt = `DOCUMENTO PDF CARGADO ("${activePdfContext.filename}", ${activePdfContext.pageCount} páginas):
"""
${docSlice}
"""

PREGUNTA DEL USUARIO:
${userQuery}`;
            }

            // Build multi-turn contents (last 4 turns for speed)
            const recentTurns = options.isolated ? [] : chatHistoryMemory.slice(-4);
            const contents = [
                ...recentTurns,
                { role: "user", parts: [{ text: finalPrompt }] }
            ];

            const payload = {
                contents,
                systemInstruction: { parts: [{ text: systemPrompt }] }
            };

            if (activeChatMode === 'web' || options.useWebSearch) {
                payload.tools = [{ "google_search": {} }];
            }

            let delay = 800;
            for (let attempt = 0; attempt < 3; attempt++) {
                const res = await fetch(apiUrl, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload)
                });

                if (res.ok) {
                    const result = await res.json();
                    const candidate = result.candidates?.[0];
                    const text = candidate?.content?.parts?.[0]?.text || "No se recibió texto en la respuesta.";

                    let sources = [];
                    const attributions = candidate?.groundingMetadata?.groundingAttributions;
                    if (Array.isArray(attributions)) {
                        sources = attributions
                            .map(a => ({ uri: a.web?.uri, title: a.web?.title }))
                            .filter(s => s.uri && s.title)
                            .slice(0, 4);
                    }

                    if (!options.isolated) {
                        chatHistoryMemory.push({ role: "user", parts: [{ text: userQuery }] });
                        chatHistoryMemory.push({ role: "model", parts: [{ text }] });
                    }
                    return { text, sources };
                }

                if (attempt < 2 && (res.status === 429 || res.status >= 500)) {
                    await new Promise(r => setTimeout(r, delay));
                    delay *= 2;
                    continue;
                }

                const errJson = await res.json().catch(() => ({}));
                throw new Error(errJson.error?.message || `Error HTTP ${res.status}`);
            }
        }

