        async function processPdfFile(file) {
            if (!file || file.type !== 'application/pdf') {
                showToast('Selecciona un archivo PDF válido.', 'error');
                return;
            }

            const titleEl = document.getElementById('pdf-status-title');
            const subEl = document.getElementById('pdf-status-subtitle');
            const progWrap = document.getElementById('pdf-progress-wrap');
            const progBar = document.getElementById('pdf-progress-bar');

            const t0 = performance.now();
            titleEl.textContent = `Leyendo ${file.name}...`;
            subEl.textContent = 'Extracción paralela ultrarrápida...';
            progWrap.classList.remove('hidden');
            progBar.style.width = '20%';

            try {
                const buffer = await file.arrayBuffer();
                const pdf = await pdfjsLib.getDocument({ data: buffer }).promise;
                const totalPages = pdf.numPages;
                progBar.style.width = '55%';

                // Extract pages concurrently in batches for maximum speed!
                const pagePromises = [];
                for (let p = 1; p <= totalPages; p++) {
                    pagePromises.push(
                        pdf.getPage(p).then(async (page) => {
                            const content = await page.getTextContent();
                            const text = content.items.map(it => it.str).join(' ');
                            return `\n[PÁGINA ${p}]\n${text}`;
                        })
                    );
                }

                const pagesArray = await Promise.all(pagePromises);
                const fullText = pagesArray.join('\n');
                const elapsedMs = Math.round(performance.now() - t0);
                const sizeStr = (file.size / 1024).toFixed(1) + ' KB';

                progBar.style.width = '100%';
                setTimeout(() => progWrap.classList.add('hidden'), 350);

                activePdfContext = {
                    filename: file.name,
                    text: fullText,
                    pageCount: totalPages,
                    sizeStr
                };

                titleEl.textContent = file.name;
                subEl.textContent = `${totalPages} pág. • ${sizeStr} • Leído en ${elapsedMs}ms`;
                document.getElementById('btn-remove-pdf').classList.remove('hidden');

                // Switch to PDF mode automatically
                setChatMode('pdf');
                weavePdfCordIntoCase(file.name, totalPages, fullText);
                showToast(`PDF indexado en ${elapsedMs}ms y tejido al Khipu`, 'success');

                appendAiMessage(`
                    <div class="space-y-1.5">
                        <span class="text-[10px] font-mono text-emerald-400 font-bold uppercase">✓ PDF Anudado en ${elapsedMs}ms</span>
                        <p>Documento cargado: <strong class="text-white">${escapeHtml(file.name)}</strong> (${totalPages} páginas).</p>
                        <p class="text-slate-300 text-[11.5px]">Ya tejí una cuerda esmeralda en el Khipu central. Pregúntame cualquier dato, resumen, cláusula o riesgo sobre este PDF.</p>
                    </div>
                `);
            } catch (err) {
                progWrap.classList.add('hidden');
                titleEl.textContent = 'Error al leer PDF';
                subEl.textContent = 'Verifica que el archivo no esté dañado';
                showToast('No se pudo extraer el PDF', 'error');
            }
        }

